{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$room": {
        "hostSecurity": {
          ".read": false,
          "keyHash": {
            ".write": "auth != null && (auth.uid === root.child('rooms').child($room).child('hostUid').val() || (!data.exists() && !root.child('rooms').child($room).child('hostUid').exists()))",
            ".validate": "newData.isString() && newData.val().length === 64"
          },
          "$other": { ".validate": false }
        },
        "hostClaims": {
          ".read": false,
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "!newData.exists() || (newData.isString() && newData.val().length === 64)"
          }
        },
        "hostSessions": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && auth.uid === $uid && (!newData.exists() || (newData.val() === true && root.child('rooms').child($room).child('hostClaims').child($uid).val() === root.child('rooms').child($room).child('hostSecurity').child('keyHash').val()))",
            ".validate": "!newData.exists() || newData.isBoolean()"
          }
        },
        "hostUid": {
          ".read": "auth != null",
          ".write": "auth != null && ((data.exists() && data.val() === auth.uid && (!newData.exists() || newData.val() === auth.uid)) || (!data.exists() && newData.val() === auth.uid && root.child('rooms').child($room).child('hostSessions').child(auth.uid).val() === true))",
          ".validate": "!newData.exists() || (newData.isString() && newData.val().length > 0 && newData.val().length < 128)"
        },
        "public": {
          ".read": "auth != null",
          ".write": "auth != null && auth.uid === root.child('rooms').child($room).child('hostUid').val()",
          "eventOpen": { ".validate": "newData.isBoolean()" },
          "showAddress": { ".validate": "newData.isBoolean()" },
          "address": { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 160)" },
          "hours": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80" },
          "roomCode": { ".validate": "newData.isString() && newData.val().length >= 4 && newData.val().length <= 8" },
          "round": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 999" },
          "$other": { ".validate": false }
        },
        "private": {
          ".read": "auth != null && auth.uid === root.child('rooms').child($room).child('hostUid').val()",
          ".write": "auth != null && auth.uid === root.child('rooms').child($room).child('hostUid').val()",
          "address": { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 160)" },
          "$other": { ".validate": false }
        },
        "game": {
          ".read": "auth != null",
          ".write": "auth != null && auth.uid === root.child('rooms').child($room).child('hostUid').val()",
          "phase": { ".validate": "newData.isString() && (newData.val() === 'board' || newData.val() === 'question' || newData.val() === 'reveal')" },
          "instanceId": { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 80)" },
          "categoryIndex": { ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= 0 && newData.val() <= 50)" },
          "questionIndex": { ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= 0 && newData.val() <= 20)" },
          "isBonus": { ".validate": "!newData.exists() || newData.isBoolean()" },
          "value": { ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000)" },
          "startedAt": { ".validate": "!newData.exists() || newData.isNumber()" },
          "revealedAt": { ".validate": "!newData.exists() || newData.isNumber()" },
          "duration": { ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= 5 && newData.val() <= 180)" },
          "scoredInstanceId": { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 80)" },
          "$other": { ".validate": false }
        },
        "used": {
          ".read": "auth != null",
          ".write": "auth != null && auth.uid === root.child('rooms').child($room).child('hostUid').val()",
          "$key": { ".validate": "!newData.exists() || newData.isBoolean()" }
        },
        "players": {
          ".read": "auth != null",
          "$uid": {
            "name": {
              ".write": "auth != null && (auth.uid === root.child('rooms').child($room).child('hostUid').val() || (auth.uid === $uid && newData.exists()))",
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 28"
            },
            "type": {
              ".write": "auth != null && (auth.uid === root.child('rooms').child($room).child('hostUid').val() || (auth.uid === $uid && newData.exists()))",
              ".validate": "newData.isString() && (newData.val() === 'solo' || newData.val() === 'team')"
            },
            "size": {
              ".write": "auth != null && (auth.uid === root.child('rooms').child($room).child('hostUid').val() || (auth.uid === $uid && newData.exists()))",
              ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 12"
            },
            "joinedAt": {
              ".write": "auth != null && (auth.uid === root.child('rooms').child($room).child('hostUid').val() || (auth.uid === $uid && newData.exists()))",
              ".validate": "newData.isNumber()"
            },
            "round": {
              ".write": "auth != null && (auth.uid === root.child('rooms').child($room).child('hostUid').val() || (auth.uid === $uid && !data.exists() && newData.val() === 0))",
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000000"
            },
            "total": {
              ".write": "auth != null && (auth.uid === root.child('rooms').child($room).child('hostUid').val() || (auth.uid === $uid && !data.exists() && newData.val() === 0))",
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000000"
            },
            "$other": { ".validate": false }
          }
        },
        "answers": {
          "$instance": {
            ".read": "auth != null && auth.uid === root.child('rooms').child($room).child('hostUid').val()",
            "$uid": {
              ".read": "auth != null && (auth.uid === $uid || auth.uid === root.child('rooms').child($room).child('hostUid').val())",
              ".write": "auth != null && (auth.uid === root.child('rooms').child($room).child('hostUid').val() || (auth.uid === $uid && root.child('rooms').child($room).child('game').child('instanceId').val() === $instance && root.child('rooms').child($room).child('game').child('phase').val() === 'question' && now <= root.child('rooms').child($room).child('game').child('startedAt').val() + (root.child('rooms').child($room).child('game').child('duration').val() * 1000)))",
              ".validate": "!newData.exists() || newData.hasChildren(['choice', 'submittedAt'])",
              "choice": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100" },
              "submittedAt": { ".validate": "newData.isNumber()" },
              "$other": { ".validate": false }
            }
          }
        },
        "$other": { ".validate": false }
      }
    }
  }
}
